  "components": {
    "schemas": {
      "ComputeJob": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "provisioning",
              "running",
              "completed",
              "failed",
              "cancelled"
            ],
            "title": "Status"
          },
          "resource_id": {
            "type": "string",
            "title": "Resource Id"
          },
          "node_id": {
            "type": "string",
            "title": "Node Id"
          },
          "cpus": {
            "type": "number",
            "title": "Cpus"
          },
          "memory_mb": {
            "type": "integer",
            "title": "Memory Mb"
          },
          "scratch_mb": {
            "type": "integer",
            "title": "Scratch Mb"
          },
          "timeout_seconds": {
            "type": "integer",
            "title": "Timeout Seconds"
          },
          "sandbox_id": {
            "type": "string",
            "title": "Sandbox Id"
          },
          "exit_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exit Code"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "cleanup_required": {
            "type": "boolean",
            "title": "Cleanup Required",
            "default": false
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "resource_id",
          "node_id",
          "cpus",
          "memory_mb",
          "scratch_mb",
          "timeout_seconds",
          "sandbox_id",
          "created_at"
        ],
        "title": "ComputeJob"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobSubmission": {
        "properties": {
          "resource_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
            "title": "Resource Id"
          },
          "node_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
            "title": "Node Id"
          },
          "cpus": {
            "type": "number",
            "maximum": 256.0,
            "exclusiveMinimum": 0.0,
            "title": "Cpus"
          },
          "memory_mb": {
            "type": "integer",
            "maximum": 1048576.0,
            "minimum": 64.0,
            "title": "Memory Mb"
          },
          "scratch_mb": {
            "type": "integer",
            "maximum": 1048576.0,
            "minimum": 16.0,
            "title": "Scratch Mb"
          },
          "timeout_seconds": {
            "type": "integer",
            "maximum": 86400.0,
            "minimum": 1.0,
            "title": "Timeout Seconds"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "resource_id",
          "node_id",
          "cpus",
          "memory_mb",
          "scratch_mb",
          "timeout_seconds"
        ],
        "title": "JobSubmission"
      },
      "NodeRegistration": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
            "title": "Id"
          },
          "cpus": {
            "type": "number",
            "maximum": 65536.0,
            "exclusiveMinimum": 0.0,
            "title": "Cpus"
          },
          "memory_mb": {
            "type": "integer",
            "maximum": 1099511627776.0,
            "minimum": 64.0,
            "title": "Memory Mb"
          },
          "status": {
            "type": "string",
            "enum": [
              "online",
              "offline"
            ],
            "title": "Status",
            "default": "online"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "cpus",
          "memory_mb"
        ],
        "title": "NodeRegistration"
      },
      "StdinMessage": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Id"
          },
          "line": {
            "type": "string",
            "maxLength": 2097152,
            "title": "Line"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "line"
        ],
        "title": "StdinMessage"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
