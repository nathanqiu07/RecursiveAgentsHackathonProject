# Optional read-only Crusoe capacity connection. Keep secrets on the server.
CRUSOE_ACCESS_KEY_ID=
CRUSOE_SECRET_KEY=

# Local API and database defaults:
DASHBOARD_API_PORT=3001
# DASHBOARD_DB_PATH=/absolute/path/to/dashboard.sqlite
# DASHBOARD_API_KEY=

# Optional benchmark verifier bearer token. Set a benchmark's auth_env to this name.
# BENCHMARK_VERIFIER_SERVICE_KEY=
# Agent Harness connection, used only by the dashboard server.
AGENT_HARNESS_URL=http://127.0.0.1:8003
AGENT_HARNESS_API_KEY=
