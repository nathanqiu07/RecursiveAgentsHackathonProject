# Reference only; export these variables in the API/worker shells.
HARNESS_API_KEY=
# HARNESS_DB_PATH=/absolute/path/to/harness/data/harness.sqlite3
HARNESS_LIBRARY_URL=http://127.0.0.1:8001
HARNESS_LIBRARY_API_KEY=
HARNESS_BENCHMARK_URL=http://127.0.0.1:3001
HARNESS_BENCHMARK_API_KEY=
HARNESS_RESOURCE_MANAGER_URL=http://127.0.0.1:8002
HARNESS_RESOURCE_MANAGER_API_KEY=
# Codex uses the existing local `codex login` (ChatGPT OAuth) by default in the dashboard.
# Optional built-in harness model; alternatively save Crusoe credentials in Connections.
HARNESS_MODEL_BASE_URL=
HARNESS_MODEL=
HARNESS_MODEL_API_KEY=
# Optional alternative environment configuration for Connections.
CRUSOE_INFERENCE_API_KEY=
CRUSOE_MODEL=
HARNESS_YOU_API_KEY=
# Encryption key normally generated as <HARNESS_DB_PATH>.settings.key (0600).
# HARNESS_SETTINGS_KEY=<Fernet key shared by API and workers>
# HARNESS_CODEX_BIN=/absolute/path/to/codex
# HARNESS_CLAUDE_CODE_BIN=/absolute/path/to/claude
# HARNESS_CLAUDE_API_KEY=
# HARNESS_NEMOCLAW_ENABLED=1
# HARNESS_NEMOCLAW_BIN=/absolute/path/to/nemoclaw
# HARNESS_NEMOCLAW_API_KEY=
# Optional search gateway: GET URL?q=... returns JSON search results with source URLs.
HARNESS_SEARCH_URL=
HARNESS_SEARCH_API_KEY=
